<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.all.ssh-agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SSH_ASKPASS</key>
        <string>echo</string>
        <key>SSH_ASKPASS_REQUIRE</key>
        <string>force</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>ssh-add</string>
        <string>--apple-load-keychain</string>
        <string>-S</string>
        <string>/usr/lib/ssh-keychain.dylib</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
